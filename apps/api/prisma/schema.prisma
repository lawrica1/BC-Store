generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String                 @id @default(cuid())
  email       String                 @unique
  password    String?
  role        Role                   @default(CUSTOMER)
  name        String
  phone       String?
  technicians RepairTicket[]
  orders      Order[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
}

model Product {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  category    Category
  price       Decimal     @db.Decimal(12, 0)
  stock       Int
  images      String[]
  description String?
  isActive    Boolean     @default(true)
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([category])
}

model RepairTicket {
  id            String       @id @default(cuid())
  ticketNumber  String       @unique @default(cuid())
  deviceType    String
  brand         String
  model         String
  faultDesc     String       @db.Text
  serviceType   String
  storeAddress  String?
  homeAddress   String?
  visitDate     DateTime?
  transportZone         String?
  estimatedTransportFee Decimal?   @db.Decimal(12, 0)
  transportFee          Decimal?   @db.Decimal(12, 0)
  customerName  String
  customerPhone String
  customerEmail String?
  status        TicketStatus @default(PENDING)
  assignedTo    String?
  assignedUser  User?        @relation(fields: [assignedTo], references: [id])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status])
}

model Order {
  id                    String      @id @default(cuid())
  orderNumber           String      @unique @default(cuid())
  customerName          String
  customerPhone         String
  customerEmail         String?
  deliveryAddress       String
  deliveryMethod        String
  deliveryFee           Decimal     @default(0) @db.Decimal(12, 0)
  total                 Decimal     @db.Decimal(12, 0)
  paymentMethod         String
  paymentReceiverPhone  String
  status                OrderStatus @default(PENDING_PAYMENT)
  stripePaymentIntentId String?     @unique
  stripeClientSecret    String?
  providerReference     String?
  paymentUrl            String?
  userId                String?
  user                  User?       @relation(fields: [userId], references: [id])
  items                 OrderItem[]
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@index([status])
  @@index([providerReference])
  @@index([userId])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Decimal @db.Decimal(12, 0)

  @@index([orderId])
  @@index([productId])
}

model ServiceRequest {
  id            String              @id @default(cuid())
  serviceType   String
  description   String              @db.Text
  photoUrl      String?
  customerName  String
  customerPhone String
  customerEmail String?
  status        ServiceRequestStatus @default(PENDING)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

enum Role {
  ADMIN
  TECHNICIAN
  CUSTOMER
}

enum Category {
  CASQUE
  ECOUTEUR
  CHARGEUR
  POWERBANK
  TELEPHONE
  ORDINATEUR
}

enum TicketStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  FAILED
  CANCELLED
}

enum ServiceRequestStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}
